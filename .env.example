# Copier vers .env puis changer TOUTES les valeurs. Ne jamais commiter .env.
POSTGRES_USER=assistant
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=assistant

# Hors Docker uniquement (docker compose l'écrase pour le backend)
DATABASE_URL=postgresql+psycopg2://assistant:change-me-strong-password@localhost:5432/assistant

# Générer : python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Mot de passe des comptes de démo (>=12 car., majuscule, minuscule, chiffre). Vide => aléatoire, affiché une fois.
SEED_PASSWORD=
CORS_ORIGINS=["http://localhost:5173"]

# --- Embeddings : "sentence-transformers" (nécessite INSTALL_AI=true) ou "hash" (démo hors-ligne SANS sémantique)
INSTALL_AI=false
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# --- Reranker : "cross-encoder" ou "none". Un modèle fine-tuné peut être imposé via RERANKER_PATH,
#     sinon la version marquée « deployed » dans le dashboard MLOps est utilisée.
RERANKER_BACKEND=cross-encoder
RERANKER_BASE_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_PATH=

# --- LLM (Ollama). Démarrer avec : docker compose --profile ollama up -d  puis  docker compose exec ollama ollama pull <modèle>
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b

# --- RAG
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=30
RERANK_TOP_N=5
MIN_RETRIEVAL_SCORE=0.2
